<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-screen feedback pill; inflated by JoystickKeyService (no AppCompat, so android:tint). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_osd"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <ImageView
            android:id="@+id/osdIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_play_btn"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:tint="@color/ja_on_accent"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/ja_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/osdSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:textColor="@color/ja_text_2"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
